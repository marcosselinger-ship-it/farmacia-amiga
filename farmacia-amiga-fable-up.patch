diff --git a/firestore/firestore.rules b/firestore/firestore.rules
index 78a36b7..b8d4a85 100644
--- a/firestore/firestore.rules
+++ b/firestore/firestore.rules
@@ -40,11 +40,23 @@ service cloud.firestore {
       allow create, delete: if false;
     }
 
+    // Escrita só pelo servidor (/api/medications), que confere se o paciente é da mesma farmácia.
     match /medications/{medicationId} {
       allow read: if isPaciente() && userId() == resource.data.patient_user_id;
       allow read: if (isAdminFarmacia() || isFarmaceutico()) && belongsToSamePharmacy(resource.data.pharmacy_id);
-      allow create, update: if (isAdminFarmacia() || isFarmaceutico()) && belongsToSamePharmacy(request.resource.data.pharmacy_id);
-      allow delete: if false;
+      allow write: if false;
+    }
+
+    // Doses confirmadas pelo paciente. Escrita só pelo servidor (/api/doses).
+    match /dose_logs/{logId} {
+      allow read: if isPaciente() && userId() == resource.data.patient_user_id;
+      allow read: if (isAdminFarmacia() || isFarmaceutico()) && belongsToSamePharmacy(resource.data.pharmacy_id);
+      allow write: if false;
+    }
+
+    // Índice código -> farmácia. Nunca legível pelo cliente (evita enumerar farmácias).
+    match /pharmacy_codes/{code} {
+      allow read, write: if false;
     }
 
     match /medication_schedules/{scheduleId} {
@@ -98,7 +110,7 @@ service cloud.firestore {
     match /consents/{consentId} {
       allow read: if isAuthenticated() && resource.data.user_id == userId();
       allow read: if isAdminFarmacia() && belongsToSamePharmacy(resource.data.pharmacy_id);
-      allow create: if isAuthenticated() && request.resource.data.user_id == userId() && request.resource.data.timestamp == request.time;
+      allow create: if isAuthenticated() && request.resource.data.user_id == userId() && request.resource.data.pharmacy_id == userPharmacyId() && request.resource.data.timestamp == request.time;
       allow update, delete: if false;
     }
 
diff --git a/functions/src/index.ts b/functions/src/index.ts
index 1461bd1..85f2b68 100644
--- a/functions/src/index.ts
+++ b/functions/src/index.ts
@@ -52,9 +52,12 @@ export const onUserCreated = onDocumentCreated(
     if (!snapshot) return;
     const data = snapshot.data();
     const uid = event.params.uid;
-    const claims: Record<string, string> = { role: data.role || "paciente" };
-    if (data.pharmacy_id) claims.pharmacy_id = data.pharmacy_id;
+    // users/{uid} só é criado pelo servidor (/api/signup). Mesmo assim, este gatilho nunca
+    // concede superadmin/farmaceutico: esses papéis só via setUserClaims (superadmin).
+    const role = data.role === "admin_farmacia" && data.pharmacy_id === uid ? "admin_farmacia" : "paciente";
+    const claims: Record<string, string> = { role };
+    if (typeof data.pharmacy_id === "string") claims.pharmacy_id = data.pharmacy_id;
     await admin.auth().setCustomUserClaims(uid, claims);
-    console.log(`Claims setados para ${uid}:`, claims);
+    console.log(`Claims setados para ${uid}: role=${role}`);
   }
 );
